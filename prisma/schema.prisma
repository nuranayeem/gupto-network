generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  aboutEmail            String?
  aboutEmailVisible     Boolean                @default(true)
  phoneNumber           String?
  username              String?                @unique
  name                  String?
  bio                   String?
  image                  String?
  coverImage             String?
  coverPositionX         Float                  @default(0)
  coverPositionY         Float                  @default(0)
  coverZoom              Float                  @default(1)
  location               String?
  hometown               String?
  school                 String?
  college                String?
  university             String?
  relationshipStatus     String?
  gender                 String?
  workplaces             Json                   @default("[]")
  interests              String[]               @default([])
  socialLinks            String[]               @default([])
  website                String?
  avatarTheme            String                 @default("midnight")
  birthDate              DateTime?              @db.Date
  category               String?
  passwordHash          String?
  emailVerified         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  passwordResetRequests PasswordResetRequest[]
  posts                 Post[]
  postReactions         PostReaction[]
  postComments          PostComment[]
  postReplies           PostReply[]
  commentReactions      CommentReaction[]
  replyReactions        ReplyReaction[]
  sentFriendships       Friendship[]           @relation("FriendshipRequester")
  receivedFriendships   Friendship[]           @relation("FriendshipAddressee")
  following             Follow[]               @relation("FollowFollower")
  followers             Follow[]               @relation("FollowFollowing")
  stories               Story[]
  storyViews            StoryView[]
}

enum PostVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum ReactionType {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
  SANDAL
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum StoryMediaType {
  PHOTO
  VIDEO
  MUSIC
  PHOTO_MUSIC
}

enum StoryAudience {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

model Story {
  id              String          @id @default(cuid())
  authorId        String
  mediaType       StoryMediaType
  mediaUrl        String?
  audioUrl        String?
  audioStartSeconds Float    @default(0)
  audioDurationSeconds Float @default(20)
  backgroundColorA String     @default("#4b3d36") @db.VarChar(16)
  backgroundColorB String     @default("#766052") @db.VarChar(16)
  backgroundColorC String     @default("#b3927c") @db.VarChar(16)
  mediaScale      Float           @default(1)
  mediaRotation   Int             @default(0)
  mediaFlipX      Boolean         @default(false)
  mediaFlipY      Boolean         @default(false)
  mediaOffsetX    Float           @default(0)
  mediaOffsetY    Float           @default(0)
  mediaFit        String          @default("COVER") @db.VarChar(12)
  mediaFrame      String          @default("PORTRAIT") @db.VarChar(16)
  caption         String?         @db.VarChar(180)
  captionFont     String          @default("MODERN") @db.VarChar(16)
  captionSize     String          @default("MEDIUM") @db.VarChar(12)
  captionFontSize Int             @default(17)
  captionAlign    String          @default("CENTER") @db.VarChar(12)
  captionBold     Boolean         @default(true)
  captionItalic   Boolean         @default(false)
  captionColor    String          @default("#ffffff") @db.VarChar(16)
  captionBg       String          @default("NONE") @db.VarChar(16)
  captionBgColor  String          @default("#171922") @db.VarChar(16)
  captionPosition String          @default("BOTTOM") @db.VarChar(12)
  captionOffsetX  Float           @default(50)
  captionOffsetY  Float           @default(82)
  captionRotation Int             @default(0)
  musicTitle      String?         @db.VarChar(80)
  accent          String          @default("violet") @db.VarChar(24)
  audience        StoryAudience   @default(PUBLIC)
  durationSeconds Int             @default(7)
  allowReplies    Boolean         @default(true)
  expiresAt       DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  views           StoryView[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
  @@index([audience, expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  viewedAt  DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([viewerId, viewedAt])
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  text       String         @db.VarChar(280)
  visibility PostVisibility @default(PUBLIC)
  editedAt   DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions  PostReaction[]
  comments   PostComment[]

  @@index([authorId])
  @@index([visibility])
  @@index([createdAt])
}

model PostReaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model PostComment {
  id        String      @id @default(cuid())
  postId    String
  authorId  String
  text      String      @db.VarChar(500)
  editedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   PostReply[]
  reactions CommentReaction[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model PostReply {
  id            String      @id @default(cuid())
  commentId     String
  authorId      String
  parentReplyId String?
  text          String      @db.VarChar(500)
  editedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  comment       PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReply   PostReply?   @relation("ReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies  PostReply[]  @relation("ReplyThread")
  reactions     ReplyReaction[]

  @@index([commentId, createdAt])
  @@index([parentReplyId, createdAt])
  @@index([authorId, createdAt])
}


model CommentReaction {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  comment   PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId, createdAt])
  @@index([userId, createdAt])
}

model ReplyReaction {
  id        String       @id @default(cuid())
  replyId   String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  reply     PostReply    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId, createdAt])
  @@index([userId, createdAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

model PendingSignup {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  name           String
  passwordHash   String
  otpHash        String
  otpExpiresAt   DateTime
  expiresAt      DateTime
  otpAttempts    Int      @default(0)
  otpResendCount Int      @default(0)
  lastOtpSentAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordResetRequest {
  id                  String   @id @default(cuid())
  userId              String
  email               String
  otpHash             String
  otpExpiresAt        DateTime
  expiresAt           DateTime
  otpAttempts         Int      @default(0)
  otpResendCount      Int      @default(0)
  lastOtpSentAt       DateTime @default(now())
  verifiedAt          DateTime?
  resetTokenHash      String?  @unique
  resetTokenExpiresAt DateTime?
  usedAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
}
